# SERVER ONLY: never use VITE_ or save keys in browser/localStorage.
XAI_API_KEY=
GROK_MODEL=grok-4.7
GROK_WEB_SEARCH=false
GROK_SEARCH_DOMAINS=rctconline.com
# Dedicated backend database. Apply server/schema.sql before enabling writes.
DATABASE_URL=
# Alternative: persistent volume for single server only; not ephemeral hosting.
DATA_DIR=
OPS_PASSWORD=
OPS_ACTOR=operator
SESSION_SECRET=
SYNC_SECRET=
AUTO_SYNC=false
AUTO_ANALYSE=false
SYNC_INTERVAL_MS=60000
# Each feed requires explicit automated access/republication permission.
# See docs/LIVE_DATA_HANDOFF.md for envelope and event format.
RACE_FEEDS_JSON=[]
PORT=3000
